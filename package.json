{
  "name": "builder-studio",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0",
  "description": "Desktop workstation for the Minecraft AI build engine",
  "main": "./out/main/index.js",
  "author": "ModerNik",
  "homepage": "https://github.com/ModerNik/builder-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/ModerNik/builder-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ModerNik/builder-studio/issues"
  },
  "keywords": [
    "minecraft",
    "litematica",
    "schematics",
    "electron",
    "threejs",
    "ai",
    "mcp"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false --incremental --tsBuildInfoFile node_modules/.cache/tsc-node.tsbuildinfo",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false --incremental --tsBuildInfoFile node_modules/.cache/tsc-web.tsbuildinfo",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && npm run prepare:delivery && npm run licences && electron-builder --dir",
    "build:win": "npm run build && npm run prepare:delivery && npm run licences && electron-builder --win --publish never",
    "release": "npm run build && npm run prepare:delivery && npm run licences && npm run legal:check && electron-builder --win --publish always",
    "test": "vitest run",
    "licences": "node scripts/licences.mts",
    "legal:check": "node scripts/check-legal.mts",
    "build:renderer-lib": "vite build -c vite.renderer-lib.config.mts",
    "prepare:delivery": "node scripts/prepare-delivery.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^1.8.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.2",
    "app-builder-lib": "^26.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "deepslate": "^0.27.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fflate": "^0.8.3",
    "gl-matrix": "^3.4.4",
    "js-yaml": "^4.3.2",
    "lucide-react": "^1.62.0",
    "n8ao": "^1.10.3",
    "postprocessing": "^6.37.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.15.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
