# Development-only environment variables for Builder Studio.
# Copy to `.env` (or `.env.local` / `.env.development.local`) and fill in your local paths.
# Loaded only in development (`npm run dev` / `npm start`), never in packaged builds or unit tests.
# Leave values blank to fall back to `settings.json` or automatic detection.
# Use unquoted or single-quoted Windows paths so backslashes are preserved verbatim.

# Isolated Electron user-data profile directory (optional; defaults to %APPDATA%\builder-studio)
# BS_USER_DATA=out/dev-profile

# First-run setup state
# BS_SETUP_COMPLETED=true
# BS_SETUP_STEP=verify

# Workspace and storage folders
# BS_WORKSPACE=
# BS_ASSETS=
# BS_IMPORT_SOURCE=

# Build tools, engine resources and cache
# BS_RESOURCES=
# BS_RUNTIME_HOME=
# BS_RUNTIME=
# BS_PREVIOUS_RUNTIME=
# BS_CACHE=
# BS_PYTHON=
# BS_BROWSER=
# BS_GIT=

# Minecraft target, game files and export folders
# BS_MINECRAFT_VERSION=26.3
# BS_JAR=
# BS_PACK=
# BS_SCHEMATICS=
# BS_SAVES=

# AI assistant
# BS_PROVIDER=claude
# BS_CLAUDE=
# BS_CODEX=
# BS_GIT_BASH=
# BS_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# BS_OLLAMA_MODEL=
# BS_VARIANT_CAP=3

# Appearance
# BS_THEME=dark
# BS_SCALE=1
